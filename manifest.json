{
  "manifest_version": 3,
  "name": "Style Changer",
  "version": "1.0.0",
  "description": "ページのフォントスタイルを自由に変更できる拡張機能",

  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Style Changer",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": ["<all_urls>"]
}
